# Node dependencies
node_modules/

# Build output (rebuilt by `npm run build` / the deploy & CI workflows —
# no reason to carry hashed bundles and images in git history)
dist/

# TypeScript incremental build cache + stray compiled config leftovers
*.tsbuildinfo
/vite.config.js
/vite.config.d.ts

# Patch files (used ad-hoc during development, never meant to be committed)
*.patch

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment files
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Generated archives
*.zip

# Cloudflare local state (optional)
.dev.vars


# Android native project (Capacitor) — the project itself is tracked,
# only its generated/build output and local machine config are ignored.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/*.iml
android/.idea/

# Neutralino downloaded binaries + local runtime files (fetched by
# `npx neu update`, rebuilt by `npx neu build` — not meant for git)
bin/
resources.neu
neutralinojs.log
.tmp/
dist/deb-build/
dist/deb/

ios/
