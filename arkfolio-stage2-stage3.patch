+import{d as l,o as s,c as a,b as t,t as i,w as p,i as d,h as o,f as c,g as h,F as u,r as y,a as v}from"./index-uYtZhsFD.js";const w={style:{"padding-top":"0"}},m={class:"wrap container-narrow"},g={class:"legal-card"},b="July 2026",f="contact@rae-ark.example",x=l({__name:"PrivacyPolicyPage",setup(k){return(T,e)=>{const r=y("router-link"),n=v("reveal");return s(),a(u,null,[t("section",{class:"hero",style:{"padding-bottom":"36px"}},[t("div",{class:"wrap"},[e[0]||(e[0]=t("span",{class:"eyebrow"},"Legal",-1)),e[1]||(e[1]=t("h1",{style:{"font-size":"clamp(2rem,4vw,2.8rem)"}},"Privacy Policy",-1)),t("p",{class:"lede"},"Last updated: "+i(b))])]),p((s(),a("section",w,[t("div",m,[t("div",g,[e[4]||(e[4]=d("<p> This site and app (&quot;Rae ARK&quot;) is an author portfolio. It exists to showcase web novels, journal updates, and ways to read or support the work. This policy explains what little data is involved and why. </p><h3>What&#39;s collected</h3><p> The site itself does not run analytics, trackers, or advertising, and it does not create accounts or store personal data on a server. The only place personal information can enter the picture is the Feedback page, which opens your own email app with a pre-filled address and subject — anything you write there is sent directly from your device using your own email provider, under that provider&#39;s privacy policy, not ours. </p><h3>App permissions (Android)</h3><p> The Android app requests internet access only. This is used to open external links — Royal Road, Scribble Hub, X/Twitter, and similar — in your browser, and to check for updated content on future visits. The app does not request access to your contacts, location, camera, microphone, storage, or any other device permission. </p><h3>Local storage</h3><p> A single preference — whether you&#39;ve chosen light or dark mode — is saved on your own device so it&#39;s remembered next time. It never leaves your device and isn&#39;t linked to you personally. </p><h3>Third-party links</h3><p> Buttons and links to Royal Road, Scribble Hub, X/Twitter, and retail storefronts take you to third-party sites with their own privacy policies. Once you leave this site or app, this policy no longer applies. </p><h3>Children&#39;s privacy</h3><p> This site is not directed at children under 13, and no data is knowingly collected from them. </p><h3>Changes to this policy</h3><p> If this policy changes, the update will be posted here with a new &quot;last updated&quot; date. </p><h3>Contact</h3>",14)),t("p",null,[e[3]||(e[3]=o(" Questions about this policy can be sent via the ",-1)),c(r,{to:"/feedback"},{default:h(()=>[...e[2]||(e[2]=[o("Feedback",-1)])]),_:1}),o(" page, or to "+i(f)+". ")])])])])),[[n]])],64)}}});export{x as default};
