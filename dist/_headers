# Read by Cloudflare Workers static assets at deploy time.
# Vite content-hashes everything under /assets/, so those files are safe
# to cache forever; the service worker and manifest should always be
# revalidated so updates roll out promptly.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600
